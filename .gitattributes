# This repo is authored on Windows but built/simulated on Linux/WSL.
# Force LF for everything so bash scripts and file-I/O test vectors are not
# corrupted by CRLF on checkout.
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.vhd  text eol=lf
*.tcl  text eol=lf
*.xdc  text eol=lf
*.tv   text eol=lf
*.md   text eol=lf
